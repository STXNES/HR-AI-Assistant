# =====================================================================
# Configuración de Entorno: HR Buddy (ChocolaTech)
# =====================================================================

# 1. Base de Datos
# 'mysql' para producción con contenedor MySQL, 'sqlite' para desarrollo local sin Docker
DB_TYPE=sqlite
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=chocolatech123
MYSQL_DATABASE=chocolatech

# 2. Proveedor de LLM ('groq', 'gemini' o 'openai')
# Nota: Si no se configuran llaves API, el agente usará automáticamente el motor de contingencia local
LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# 3. Integración de Telegram Bot
# Obtén tu token mediante @BotFather en Telegram
TELEGRAM_BOT_TOKEN=

# 4. Servidor FastAPI
PORT=8000
HOST=0.0.0.0
